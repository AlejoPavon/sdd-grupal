# better-sqlite3@13 incluye binarios N-API precompilados: no hace falta
# compilar con node-gyp (ni instalar Visual Studio / build tools de C++).
# npm 10 y 11 ejecutan `node-gyp rebuild` por defecto al detectar binding.gyp,
# así que se desactivan los scripts de instalación en todo el proyecto.
ignore-scripts=true

# Falla temprano con un mensaje claro si Node no cumple engines.node (>=22.13).
engine-strict=true
